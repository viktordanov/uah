--new-session
--die-with-parent
--ro-bind / /
--dev /dev
--bind $SYSTMP $SYSTMP
--bind $BASE/ws $BASE/ws
--bind $BASE/main $BASE/main
--bind $BASE/tmpdir $BASE/tmpdir
--ro-bind $BASE/ws/.git $BASE/ws/.git
--ro-bind $BASE/main/.git $BASE/main/.git
--ro-bind $BASE/main/.git/worktrees/ws $BASE/main/.git/worktrees/ws
--unshare-user
--unshare-pid
--unshare-ipc
--unshare-net
--proc /proc
--cap-drop ALL
